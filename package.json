{
  "name": "settle-down",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:production": "expo start --no-dev --minify",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --max-warnings=0",
    "type-check": "tsc --noEmit",
    "build:preview": "eas build --profile preview",
    "build:production": "eas build --profile production",
    "update:preview": "eas update --channel preview --environment preview",
    "update:production": "eas update --channel production --environment production",
    "build:preview:org": "EAS_PROJECT_OWNER=org-ryan eas build --profile preview",
    "build:production:org": "EAS_PROJECT_OWNER=org-ryan eas build --profile production",
    "update:preview:org": "EAS_PROJECT_OWNER=org-ryan eas update --channel preview --environment preview",
    "update:production:org": "EAS_PROJECT_OWNER=org-ryan eas update --channel production --environment production",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:tooling": "npm test --prefix tools/verify-ios",
    "check:dependencies": "expo install --check",
    "check:expo": "expo-doctor",
    "check:unused": "knip",
    "bundle:ios": "expo export --platform ios --output-dir dist/ios",
    "bundle:android": "expo export --platform android --output-dir dist/android",
    "check": "npm run format:check && npm run lint && npm run type-check && npm run test:ci && npm run test:tooling && npm run check:unused"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-community/datetimepicker": "9.3.0",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "~58.0.26",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.13",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-media-library": "~58.0.14",
    "expo-router": "~58.0.32",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.22",
    "expo-web-browser": "~58.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.5.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "expo-doctor": "1.21.8",
    "globals": "17.14.0",
    "jest": "30.5.2",
    "jest-expo": "58.0.15",
    "jest-junit": "17.0.0",
    "knip": "6.45.1",
    "prettier": "3.10.1",
    "test-renderer": "1.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "private": true,
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >= 26.0.0"
  }
}
